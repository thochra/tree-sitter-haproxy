{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "haproxy",
      "camelcase": "HAProxy",
      "title": "HAProxy",
      "scope": "source.haproxy",
      "file-types": ["haproxy.conf", "haproxy.cfg"],
      "injection-regex": "^haproxy$",
      "class-name": "TreeSitterHaproxy"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "HAProxy grammar",
    "authors": [
      {
        "name": "thochra"
      }
    ],
    "links": {
      "repository": "https://github.com/thochra/tree-sitter-haproxy"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
